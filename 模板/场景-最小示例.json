{
  "_说明": "最小场景模板（不接 AI）：改 3 处即可用 —— ① 文件名必须与 id 同名（本文件应另存为 demo.json）② name/description 改成你的 ③ 各面板 id 换成你自己的前缀。类型只用内置的 view / file / reserved，不需要写任何代码。",

  "id": "demo",
  "name": "<场景名>",
  "description": "<一句话说明>",

  "cols": 4,
  "panels": [
    { "id": "demo-main",  "title": "主视图", "type": "view",     "col": 1, "row": 1, "w": 3, "h": 2 },
    { "id": "demo-files", "title": "文件",   "type": "file",     "col": 4, "row": 1, "w": 1, "h": 2 },
    { "id": "demo-note",  "title": "预留",   "type": "reserved", "col": 1, "row": 3, "w": 4, "h": 1 }
  ]
}
